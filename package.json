{
  "name": "actions-manual-approval",
  "version": "3.0.0",
  "description": "GitHub Action that replaces the native environment wait timer with a timer that is cancelled as soon as a required reviewer approves the deployment.",
  "main": "dist/index.js",
  "private": true,
  "license": "MIT",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "lint": "eslint .",
    "test": "jest",
    "build": "ncc build src/main.js -o dist --license licenses.txt",
    "all": "npm run lint && npm test && npm run build"
  },
  "keywords": [
    "github-actions",
    "environments",
    "deployments",
    "manual-approval",
    "wait-timer"
  ],
  "dependencies": {
    "@actions/core": "^1.11.1",
    "@actions/github": "^6.0.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.0",
    "@semantic-release/changelog": "^7.0.0",
    "@semantic-release/git": "^11.0.1",
    "@vercel/ncc": "^0.38.3",
    "conventional-changelog-conventionalcommits": "^9.3.1",
    "eslint": "^9.39.0",
    "globals": "^15.15.0",
    "jest": "^29.7.0",
    "semantic-release": "^25.0.9"
  },
  "jest": {
    "testEnvironment": "node",
    "clearMocks": true,
    "collectCoverageFrom": [
      "src/**/*.js",
      "!src/main.js"
    ],
    "testMatch": [
      "**/__tests__/**/*.test.js"
    ]
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/validation-projects/actions-manual-approval.git"
  }
}
